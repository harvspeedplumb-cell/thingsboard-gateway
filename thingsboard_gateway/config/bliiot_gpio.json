{
  "name": "BLIIOT X26 GPIO Connector",
  "logLevel": "INFO",
  "gpio": {
    "boardType": "X26",
    "chip": "auto",
    "pollIntervalMs": 200,
    "pollPeriod": 60,
    "reportOnChange": true,
    "eventDriven": false,
    "doAttributeUpdateSuffix": "_set"
  },
  "timeseries": [
    {"key": "DI1", "activeLow": true, "bias": "as-is", "debounceMs": 50},
    {"key": "DI2", "activeLow": true, "bias": "as-is", "debounceMs": 50},
    {"key": "DI3", "activeLow": true, "bias": "as-is", "debounceMs": 50},
    {"key": "DI4", "activeLow": true, "bias": "as-is", "debounceMs": 50},
    {"key": "DI5", "activeLow": true, "bias": "as-is", "debounceMs": 50},
    {"key": "DI6", "activeLow": true, "bias": "as-is", "debounceMs": 50},
    {"key": "DI7", "activeLow": true, "bias": "as-is", "debounceMs": 50},
    {"key": "DI8", "activeLow": true, "bias": "as-is", "debounceMs": 50}
  ],
  "serverSideRpc": [
    {"key": "DO1", "activeLow": true},
    {"key": "DO2", "activeLow": true},
    {"key": "DO3", "activeLow": true},
    {"key": "DO4", "activeLow": true}
  ],
  "attributes": [
    {
      "source": "wanStatus",
      "key": "active_wan_interface",
      "pollPeriod": 15,
      "interfaceNames": {
        "eth0": "ethernet",
        "usb0": "cellular"
      }
    }
  ],
  "devices": [
    {
      "name": "BLIIOT X26 IO",
      "type": "default",
      "converter": "BliiotGpioUplinkConverter",
      "downlink_converter": "BliiotGpioDownlinkConverter"
    }
  ]
}
